---
import projectImage from '@assets/images/project.png';
import Tags from '@components/ui/Tags.astro';
import { Image } from 'astro:assets';

interface Props {
	url?: string;
	alt?: string;
	title?: string;
  description: string;
  icono:string;
	tags: string[];
	children?: HTMLElement | HTMLElement[];
}

const {
	url = '#',
	alt = 'Project image',
	description = 'Project Description',
	title = 'Project title',
  tags = ['Tags'],
  icono = "#"
} = Astro.props;
---

<section class="w-full p-4 md:w-1/2 lg:w-1/3">
	<article
		data-testId="card"
		class="border-2 border-[#1c1c1c] rounded-xl bg-black p-3 shadow-lg duration-100 hover:scale-105 hover:transform hover:shadow-xl"
	>
		<a href={url} target=_blank aria-label="link to project">
      <div class="relative flex items-center justify-center overflow-hidden rounded-xl">
        <img class="w-40 h-40 justify-center m-6" src={icono}/>
      <!--
        <Image src={projectImage} alt={alt} format="png" width={400} height={400} loading="eager" />
      -->
			</div>
			<div class="mt-1 p-2">
				<h3 class="text-xl text-orange font-bold lg:text-2xl">{title}</h3>
				<p class="text-s text-white rounded-1xl">{description}</p>
				<Tags tags={tags} />
			</div>
		</a>
	</article>
</section>
